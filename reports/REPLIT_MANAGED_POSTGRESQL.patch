diff --git a/deploy/managed/README.md b/deploy/managed/README.md
new file mode 100644
index 0000000..ee6b330
--- /dev/null
+++ b/deploy/managed/README.md
@@ -0,0 +1,90 @@
+# Replit-managed PostgreSQL candidate
+
+This is a separate adapter for Replit's managed lifecycle. It does not weaken the
+existing isolated-development or staging gates. Do not run the staging migrator
+against a managed production database.
+
+## Development
+
+`scripts/managed/live-test.cjs` explicitly installs the reviewed schema and
+invented fixtures into an **empty Replit development Helium database**. It refuses
+deployment mode, a non-Helium endpoint, existing user tables/schema or pre-existing
+external provision evidence. It stores invented keys/credentials and its receipt
+under ignored `generated-artifacts/managed-development/`, mode 0600/0700. It never
+loads employee exports or the original SESSION_SECRET. Re-running setup refuses
+to replace or regenerate anything. Never delete the evidence to bypass this.
+
+The runtime does not import/call setup. Its connections use the platform-provided
+DATABASE_URL, a bounded pool and internal development transport. Helium's
+documented no-TLS connection is allowed **only** in the development profile and
+only for the internal `helium` endpoint. A published process cannot load that
+profile. `REPLIT_ENVIRONMENT=production` alone does not mean published execution.
+
+Actual validation:
+
+```sh
+node scripts/managed/config-test.cjs
+node scripts/managed/live-test.cjs       # one-time explicit empty-development setup
+node scripts/managed/schema-test.cjs    # rollback-only catalog probes, after setup
+node scripts/managed/preview.cjs        # temporary invented-data preview, port 5134
+```
+
+The live test is intentionally not a resettable test database command. The
+preview reuses its original synthetic dataset/keys and filesystem storage mock;
+it creates no workflow or real App Storage bucket.
+
+## Schema lifecycle
+
+`schema.cjs` is the development schema source. It reuses all 28 document codecs,
+generated columns, checks, uniqueness, graph relationships and native indices.
+It has no custom role, grant, function or trigger requirement.
+
+Managed graph foreign keys are **immediate**, rather than initially deferred.
+This is a documented stronger constraint: saves insert parents before children.
+The actual managed application tests verify those writes and orphan refusal.
+The authority check adds an explicit `production` mode without allowing the
+development runtime to accept it; `synthetic` and `frozen` remain preserved.
+
+The original three version/checksum entries remain checked if present. Publish
+does not copy their data rows. An empty ledger therefore requires the exact
+reviewed structural fingerprint AND managed release fingerprint. The structural
+contract checks columns/types/nullability/defaults/generated expressions,
+constraints and valid indices; it ignores generated object names, not semantics.
+Unknown functions, triggers, relations and RLS policy changes are blocked.
+Actual provider-generated SQL still needs Publish review/validation; local or
+Helium introspection cannot prove that future diff will retain every feature.
+
+## Production is deliberately not enabled
+
+There is no committed production manifest or activation approval.
+`production-approvals.json` is empty. Production configuration requires:
+
+- Published deployment marker and independently bound app/endpoint identity.
+- No internal/localhost endpoint, and no development identity/bucket/mock.
+- Explicit full certificate/hostname verification through the system CA store,
+  TLS >= 1.2 and channel binding; URL sslmode cannot replace that verification.
+- Original protected key fingerprints, schema/release/permission fingerprints.
+- Bound source, frozen generation, independent backup, reconciliation, custody,
+  rollback and a non-expired reviewed activation approval.
+
+Even after those checks, **startup currently refuses production** with
+`managed_production_side_effects_not_certified`. The inherited bridge captures
+email/SMS/push into synthetic delivery sinks. Enabling real employee traffic
+before a reviewed durable production delivery worker exists would be unsafe.
+This blocker is code-enforced, not merely a runbook note.
+
+Observed development credentials own the schema and are superuser-capable.
+The adapter claims neither a bq_app role nor database-enforced least privilege.
+Publishing does not create staging's custom roles/grants. The strongest prepared
+equivalent is bounded/parameterized transactional application access, exact
+identity/schema checks, no DDL/reset/fallback and an explicit production security
+approval bound to the **actual** capability fingerprint. That approval is absent.
+
+## Release boundary
+
+Replit alone applies production schema through the approved Publish diff.
+No startup DDL, production migration script, build hook, data-copy or implicit
+seed is included here. Data-only protected adoption, live App Storage identity,
+original-key continuity, real delivery, independent recovery and provider PITR
+must be qualified before updating the existing BQ Connect URL. Never roll back
+to old JSON after accepting newer SQL writes.
diff --git a/deploy/managed/config.cjs b/deploy/managed/config.cjs
new file mode 100644
index 0000000..3ee73fa
--- /dev/null
+++ b/deploy/managed/config.cjs
@@ -0,0 +1,75 @@
+// Runtime-only configuration. DATABASE_URL is consumed, never printed or persisted.
+const crypto=require("node:crypto"),fs=require("node:fs"),path=require("node:path");
+const sha=value=>crypto.createHash("sha256").update(value).digest("hex");
+const canonical=v=>JSON.stringify(v,(_,x)=>x&&typeof x==="object"&&!Array.isArray(x)?Object.fromEntries(Object.keys(x).sort().map(k=>[k,x[k]])):x);
+const issued=new WeakMap(),HEX=/^[0-9a-f]{64}$/;
+function fail(code){throw Object.assign(Error(code),{code});}
+function endpoint(env,profile){
+  if(!env.DATABASE_URL)fail("managed_connection_missing");
+  let url;try{url=new URL(env.DATABASE_URL);}catch{fail("managed_connection_invalid");}
+  if(!["postgres:","postgresql:"].includes(url.protocol)||!url.hostname||!url.pathname.slice(1))fail("managed_connection_invalid");
+  if(profile==="development"&&url.hostname!=="helium")fail("managed_development_endpoint_refused");
+  if(profile==="production"&&["helium","localhost","127.0.0.1","::1"].includes(url.hostname))fail("managed_production_endpoint_refused");
+  for(const key of url.searchParams.keys())if(!["sslmode","channel_binding"].includes(key))fail("managed_connection_option_unreviewed");
+  if(profile==="production"&&["disable","no-verify","allow","prefer"].includes(url.searchParams.get("sslmode")))fail("managed_tls_downgrade_refused");
+  url.searchParams.delete("sslmode");url.searchParams.delete("channel_binding");
+  return {url,identity:sha(canonical([env.REPL_ID,url.hostname,url.port||"5432",url.pathname,url.username]))};
+}
+function verify({env=process.env,manifest,paths={},approvalRoot=__dirname}={}){
+  if(!manifest||manifest.kind!=="BQ_REPLIT_MANAGED_V1")fail("managed_manifest_required");
+  const profile=manifest.environment;
+  if(!["development","production"].includes(profile))fail("managed_environment_invalid");
+  if(!env.REPL_ID||sha(env.REPL_ID)!==manifest.appFingerprint)fail("managed_app_identity_mismatch");
+  if(env.REPLIT_DEPLOYMENT&&!["0","1"].includes(env.REPLIT_DEPLOYMENT))fail("managed_deployment_marker_invalid");
+  if((env.REPLIT_DEPLOYMENT==="1")!==(profile==="production"))fail("managed_environment_mismatch");
+  const e=endpoint(env,profile);
+  if(e.identity!==manifest.endpointFingerprint)fail("managed_database_identity_mismatch");
+  const prefix=profile==="development"?"staging-synthetic":"managed-production";
+  if(!new RegExp(`^${prefix}-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$`).test(manifest.dataset||""))fail("managed_dataset_identity_invalid");
+  for(const name of ["schemaFingerprint","releaseFingerprint","permissionsFingerprint"])if(!HEX.test(manifest[name]||""))fail("managed_contract_missing");
+  const sessionKey=env.BQ_MANAGED_SESSION_KEY,backupKey=env.BQ_MANAGED_BACKUP_KEY;
+  if(!/^[0-9a-f]{96}$/.test(sessionKey||"")||!/^[0-9a-f]{64}$/.test(backupKey||"")||
+    sha(sessionKey)!==manifest.keys?.session||sha(backupKey)!==manifest.keys?.backup)fail("managed_key_identity_mismatch");
+  if(!/^[a-zA-Z0-9_-]{3,128}$/.test(manifest.bucket||""))fail("managed_bucket_required");
+  if(profile==="development"&&(!manifest.mockStorage||!manifest.productionBucketFingerprint||
+    sha(manifest.bucket)===manifest.productionBucketFingerprint))fail("managed_development_storage_refused");
+  if(profile==="production"){
+    if(sha(manifest.bucket)!==manifest.productionBucketFingerprint)fail("managed_production_bucket_mismatch");
+    if(manifest.mockStorage||!HEX.test(manifest.developmentEndpointFingerprint||"")||
+      e.identity===manifest.developmentEndpointFingerprint||manifest.permissionApproval!=="reviewed-managed-runtime-capabilities")fail("managed_production_binding_incomplete");
+    for(const name of ["source","backup","reconciliation","custody","rollback","frozenGeneration"])if(!HEX.test(manifest.release?.[name]||""))fail("managed_cutover_evidence_missing");
+    const approvals=JSON.parse(fs.readFileSync(path.join(approvalRoot,"production-approvals.json"),"utf8")).approvals;
+    if(!approvals.some(a=>a.id===manifest.approval&&a.operation==="managed-production-activate"&&a.binding===sha(canonical(manifest))&&
+      typeof a.approvedBy==="string"&&a.approvedBy.length&&Number.isFinite(Date.parse(a.expires))&&Date.parse(a.expires)>Date.now()))fail("managed_production_approval_missing");
+  }
+  const seal=sha(canonical([manifest.dataset,manifest.keys.session,manifest.keys.backup]));
+  const proof=Object.freeze({verifiedManaged:true,profile,dataset:manifest.dataset,seal,sessionKey,backupKey,bucket:manifest.bucket,
+    schemaFingerprint:manifest.schemaFingerprint,releaseFingerprint:manifest.releaseFingerprint,
+    permissionsFingerprint:manifest.permissionsFingerprint,endpointFingerprint:e.identity,
+    root:paths.root,app:paths.app,objects:paths.objects});
+  // Explicit SSL overrides URL sslmode without allowing node-postgres to replace
+  // the verification object. Helium is internal/plaintext; published TLS is strict.
+  issued.set(proof,{connectionString:e.url.toString(),ssl:profile==="development"?false:
+    {rejectUnauthorized:true,servername:e.url.hostname,minVersion:"TLSv1.2"},enableChannelBinding:profile==="production",
+    max:Math.min(6,Math.max(1,Number(env.BQ_MANAGED_POOL_MAX)||4)),connectionTimeoutMillis:5000,idleTimeoutMillis:10000,
+    statement_timeout:20000,lock_timeout:12000,application_name:`bq-managed-${profile}`});
+  return proof;
+}
+function assertProof(proof){if(!issued.has(proof)||!Object.isFrozen(proof))fail("managed_verified_proof_required");}
+function poolOptions(proof){assertProof(proof);return {...issued.get(proof)};}
+async function permissions(client){
+  const row=(await client.query(`SELECT rolsuper,rolcreatedb,rolcreaterole,rolbypassrls,
+    has_database_privilege(current_user,current_database(),'CREATE') AS database_create,
+    has_schema_privilege(current_user,'dev','CREATE') AS schema_create,
+    EXISTS(SELECT 1 FROM pg_roles p WHERE p.rolname<>current_user AND (p.rolsuper OR p.rolcreaterole OR p.rolbypassrls) AND pg_has_role(current_user,p.oid,'MEMBER')) AS elevated_membership
+    FROM pg_roles WHERE rolname=current_user`)).rows[0];
+  return {capabilities:row,fingerprint:sha(canonical(row))};
+}
+async function verifyDatabase(client,proof){
+  assertProof(proof);
+  if(proof.profile==="production"&&(!client.connection.stream.encrypted||!client.connection.stream.authorized))fail("managed_verified_tls_required");
+  const p=await permissions(client);
+  if(p.fingerprint!==proof.permissionsFingerprint)fail("managed_permissions_changed");
+  return p;
+}
+module.exports={verify,poolOptions,assertProof,endpoint,permissions,verifyDatabase,sha,canonical,fail};
diff --git a/deploy/managed/development.cjs b/deploy/managed/development.cjs
new file mode 100644
index 0000000..88b60cb
--- /dev/null
+++ b/deploy/managed/development.cjs
@@ -0,0 +1,49 @@
+// Explicit one-time DEVELOPMENT installation and invented-data setup.
+// Not imported by runtime. No production connection/DDL path is supported.
+const fs=require("node:fs"),path=require("node:path"),crypto=require("node:crypto");
+const {Client}=require("pg");
+const cfg=require("./config.cjs"),schema=require("./schema.cjs");
+const {saveFile}=require("../../development/postgres/repository.cjs");
+const {create}=require("../../development/postgres/fixtures.cjs");
+const {readSql}=require("../../scripts/migration/rel001/reconcile.cjs");
+function write(file,value){const fd=fs.openSync(file,"wx",0o600);try{fs.writeFileSync(fd,JSON.stringify(value));fs.fsyncSync(fd);}finally{fs.closeSync(fd);}const d=fs.openSync(path.dirname(file),"r");try{fs.fsyncSync(d);}finally{fs.closeSync(d);}}
+async function prepare({root,env=process.env,productionBucketFingerprint}){
+  if(env.REPLIT_DEPLOYMENT==="1"||!env.REPL_ID)cfg.fail("managed_development_only");
+  if(!/^[0-9a-f]{64}$/.test(productionBucketFingerprint||""))cfg.fail("production_storage_identity_required");
+  const e=cfg.endpoint(env,"development");
+  if(fs.existsSync(root))cfg.fail("managed_development_evidence_exists");
+  fs.mkdirSync(root,{recursive:true,mode:0o700});fs.chmodSync(root,0o700);
+  // Intent is independent of SQL: an empty/lost schema cannot reseed this lab.
+  const dataset=`staging-synthetic-${crypto.randomUUID()}`,sessionKey=crypto.randomBytes(48).toString("hex"),backupKey=crypto.randomBytes(32).toString("hex");
+  write(path.join(root,"intent.json"),{dataset,endpointFingerprint:e.identity,created:new Date().toISOString()});
+  const keys={sessionKey,backupKey};write(path.join(root,"keys.json"),keys);
+  const fixture=create(sessionKey,{password:`Managed-${crypto.randomBytes(18).toString("hex")}-Aa1!`,recovery:crypto.randomBytes(6).toString("hex").toUpperCase()});
+  write(path.join(root,"credentials.json"),fixture.credentials);
+  const client=new Client({connectionString:e.url.toString(),ssl:false,connectionTimeoutMillis:5000,application_name:"bq-managed-development-setup"});
+  await client.connect();
+  let manifest;
+  try{
+    await client.query("BEGIN");await client.query("SELECT pg_advisory_xact_lock(1793804287)");
+    const tables=(await client.query("SELECT count(*)::int AS n FROM information_schema.tables WHERE table_schema NOT IN ('pg_catalog','information_schema')")).rows[0].n;
+    const existing=(await client.query("SELECT 1 FROM pg_namespace WHERE nspname='dev'")).rowCount;
+    if(tables||existing)cfg.fail("managed_development_database_not_empty");
+    for(const statement of schema.statements)await client.query(statement);
+    for(const m of schema.migrations)await client.query("INSERT INTO dev.schema_migrations(version,checksum) VALUES($1,$2)",[m.version,m.checksum]);
+    const keyPrints={session:cfg.sha(sessionKey),backup:cfg.sha(backupKey)};
+    const seal=cfg.sha(cfg.canonical([dataset,keyPrints.session,keyPrints.backup]));
+    for(const [file,value]of Object.entries(fixture.files))await saveFile(client,file,value,null);
+    if(cfg.canonical((await readSql(client)).values)!==cfg.canonical(fixture.files))cfg.fail("managed_fixture_semantic_mismatch");
+    await client.query("INSERT INTO dev.authority VALUES(true,$1,$2,1,'synthetic')",[dataset,seal]);
+    const shape=await schema.describe(client),p=await cfg.permissions(client);
+    manifest={kind:"BQ_REPLIT_MANAGED_V1",environment:"development",appFingerprint:cfg.sha(env.REPL_ID),
+      endpointFingerprint:e.identity,dataset,bucket:`invented-managed-${crypto.randomUUID()}`,productionBucketFingerprint,mockStorage:true,
+      keys:keyPrints,schemaFingerprint:shape.fingerprint,releaseFingerprint:schema.releaseFingerprint,permissionsFingerprint:p.fingerprint};
+    write(path.join(root,"manifest.json"),manifest);
+    await client.query("COMMIT");
+    write(path.join(root,"receipt.json"),{dataset,seal,state:"committed"});
+    return {manifest,keys,credentials:fixture.credentials,tables:shape.tables,capabilities:p.capabilities};
+  }catch(e){await client.query("ROLLBACK").catch(()=>{});throw e;}
+  finally{await client.end();}
+}
+module.exports={prepare};
+if(require.main===module)console.error("Use the explicit synthetic managed validation harness; never run setup from an application entrypoint.");
