+// New evidence-boundary tests only. No previous development suite is repeated.
+const assert=require("node:assert/strict"),crypto=require("node:crypto"),C=require("../../deploy/managed/live-source-contract.cjs");
+const {publicKey,privateKey}=crypto.generateKeyPairSync("ed25519"),now=Date.now();
+const clone=x=>JSON.parse(JSON.stringify(x)),hash=s=>crypto.createHmac("sha256","invented-test-audit-key-only").update(s).digest("hex");
+function fill(shape){
+  if(Array.isArray(shape))return shape[0];
+  if(typeof shape==="object")return Object.fromEntries(Object.entries(shape).map(([k,v])=>[k,fill(v)]));
+  return shape==="boolean"?true:shape==="count"?0:shape==="hmac"?hash("invented"):shape==="time"?new Date(now).toISOString():"invented-serving-revision";
+}
+const complete=fill(C.schema);complete.authority.kind="json-app-storage";complete.authority.consistency="observational";
+const sign=p=>({payload:p,signature:crypto.sign(null,Buffer.from(C.canonical(p)),privateKey).toString("base64")});
+const check=(p,options={})=>C.verify(sign(p),{publicKey,expectedRevision:complete.revision,now,...options});
+let pass=0;
+function test(name,fn){fn();pass++;console.log("PASS "+name);}
+test("Complete invented signed observation validates without authorizing migration",()=>{const r=check(complete);assert.equal(r.signatureVerified,true);assert.ok(Object.values(r.operatorClaims).every(Boolean));assert.equal(r.migrationAuthorized,false);});
+test("Unknown template does not become verified zero inventory",()=>{const p=C.template();p.revision=complete.revision;p.observedAt=complete.observedAt;assert.ok(Object.values(check(p).operatorClaims).every(x=>x===false));assert.equal(p.inventory.accounts,null);});
+test("Envelope cannot export employee fields",()=>assert.throws(()=>C.verify({...sign(complete),employee:"invented"},{}),/source_evidence_envelope/));
+test("Nested account records are refused",()=>{const p=clone(complete);p.inventory.records=[];assert.throws(()=>check(p),/source_evidence_fields/);});
+test("Untrusted signing key is refused",()=>assert.throws(()=>check(complete,{publicKey:crypto.generateKeyPairSync("ed25519").publicKey}),/source_evidence_signature/));
+test("Missing independent trust anchor is refused",()=>assert.throws(()=>check(complete,{publicKey:null}),/source_evidence_trust_required/));
+test("Private signing keys are not accepted as public trust inputs",()=>assert.throws(()=>check(complete,{publicKey:privateKey.export({type:"pkcs8",format:"pem"})}),/source_evidence_public_key_only/));
+test("Serving revision must be confirmed independently",()=>assert.throws(()=>check(complete,{expectedRevision:"other-revision"}),/source_evidence_revision_mismatch/));
+test("Stale evidence is refused",()=>assert.throws(()=>check(complete,{now:now+3600001}),/source_evidence_expired/));
+test("Future evidence is refused",()=>assert.throws(()=>check(complete,{now:now-60001}),/source_evidence_expired/));
+test("Different origin is refused",()=>{const p=clone(complete);p.origin="https://invented.invalid";assert.throws(()=>check(p),/source_evidence_enum/);});
+test("All 28 source paths are required",()=>{assert.equal(C.documentNames.length,28);const p=clone(complete);delete p.inventory.documents[C.documentNames[0]];assert.throws(()=>check(p),/source_evidence_fields/);});
+test("Unkeyed record digests are not a declared algorithm",()=>{const p=clone(complete);p.algorithm="SHA-256";assert.throws(()=>check(p),/source_evidence_enum/);});
+test("Unsafe counts are refused",()=>{const p=clone(complete);p.inventory.accounts=Number.MAX_SAFE_INTEGER+1;assert.throws(()=>check(p),/source_evidence_type/);});
+test("Missing generation cannot be invented from counts",()=>{const p=clone(complete);p.authority.generationHmac=null;assert.equal(check(p).operatorClaims.source,false);});
+test("Unmapped files or missing media block inventory completion",()=>{const p=clone(complete);p.inventory.unmappedDataFiles=1;assert.equal(check(p).operatorClaims.inventory,false);p.inventory.unmappedDataFiles=0;p.inventory.media.missingReferences=1;assert.equal(check(p).operatorClaims.inventory,false);});
+test("Backup restoration must reconcile the source generation",()=>{const p=clone(complete);p.recovery.restoreGenerationHmac=hash("different");assert.equal(check(p).operatorClaims.backupRestore,false);});
+test("Pending operations and observational stability do not authorize freeze or migration",()=>{const p=clone(complete);p.writers.pendingOperations=7;assert.equal(check(p).migrationAuthorized,false);assert.match(check(p).note,/not a writer freeze/);});
+console.log(JSON.stringify({suite:"new-source-evidence-boundary",pass,fail:0,liveSourceRead:false,productionTouched:false}));
