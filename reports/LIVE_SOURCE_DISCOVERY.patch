+++ b/deploy/managed/live-source-contract.cjs
@@ -0,0 +1,81 @@
+// Aggregate-only evidence boundary. Never loads app startup/auth/storage modules,
+// connects to a service, inspects a process, or authorizes migration/activation.
+const crypto=require("node:crypto");
+const documentNames=Object.keys(require("../../development/postgres/codec.cjs").specs).sort();
+const fail=code=>{const e=new Error(code);e.code=code;throw e;};
+const schema={
+  format:["BQ_PROTECTED_SOURCE_OBSERVATION_V1"],observedAt:"time",origin:["https://bq-connect.replit.app"],
+  revision:"revision",algorithm:["HMAC-SHA256"],
+  authority:{kind:["unknown","json-app-storage","json-local","postgresql","other"],runtimeBindingChecked:"boolean",
+    datasetHmac:"hmac",generationHmac:"hmac",bucketHmac:"hmac",stableReadChecked:"boolean",consistency:["unverified","observational","frozen"]},
+  custody:{sessionPresent:"boolean",backupPresent:"boolean",activeAndPendingFactorsChecked:"boolean",
+    originalSessionContinuityChecked:"boolean",keySetHmac:"hmac"},
+  inventory:{accounts:"count",employees:"count",posts:"count",comments:"count",relationships:"count",
+    unmappedDataFiles:"count",documents:Object.fromEntries(documentNames.map(name=>[name,{present:"boolean",count:"count",originalBytesHmac:"hmac",semanticHmac:"hmac",membershipHmac:"hmac"}])),
+    media:{objectCount:"count",byteCount:"count",missingReferences:"count",unreadableObjects:"count",referenceClosureChecked:"boolean",manifestHmac:"hmac"}},
+  writers:{inventoryComplete:"boolean",processCount:"count",httpWriters:"count",backgroundWriters:"count",
+    externalWriters:"count",pendingOperations:"count",inventoryHmac:"hmac"},
+  recovery:{independentBackupAvailable:"boolean",backupGenerationHmac:"hmac",restoreReconciled:"boolean",
+    restoreGenerationHmac:"hmac",mediaComplete:"boolean"}
+};
+function inspect(value,shape){
+  if(Array.isArray(shape)){if(!shape.includes(value))fail("source_evidence_enum");return;}
+  if(typeof shape==="object"){
+    if(!value||typeof value!=="object"||Array.isArray(value))fail("source_evidence_shape");
+    if(Object.keys(value).sort().join("\0")!==Object.keys(shape).sort().join("\0"))fail("source_evidence_fields");
+    for(const key of Object.keys(shape))inspect(value[key],shape[key]);return;
+  }
+  if(shape==="boolean"&&typeof value==="boolean")return;
+  if(shape==="count"&&(value===null||(Number.isSafeInteger(value)&&value>=0)))return;
+  if(shape==="hmac"&&(value===null||(typeof value==="string"&&/^[a-f0-9]{64}$/.test(value))))return;
+  if(shape==="revision"&&typeof value==="string"&&/^[a-zA-Z0-9_-]{7,80}$/.test(value))return;
+  if(shape==="time"&&typeof value==="string"&&/^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{3}Z$/.test(value)&&new Date(value).toISOString()===value)return;
+  fail("source_evidence_type");
+}
+function canonical(value){
+  if(value&&typeof value==="object")return "{"+Object.keys(value).sort().map(k=>JSON.stringify(k)+":"+canonical(value[k])).join(",")+"}";
+  return JSON.stringify(value);
+}
+function template(shape=schema){
+  if(Array.isArray(shape))return shape[0];
+  if(typeof shape==="object")return Object.fromEntries(Object.entries(shape).map(([k,v])=>[k,template(v)]));
+  if(shape==="boolean")return false;
+  if(shape==="time")return "1970-01-01T00:00:00.000Z";
+  if(shape==="revision")return "UNCONFIRMED";
+  return null;
+}
+function verify(envelope,{publicKey,expectedRevision,now=Date.now(),maxAgeMs=60*60*1000}={}){
+  if(!envelope||Object.keys(envelope).sort().join(",")!=="payload,signature")fail("source_evidence_envelope");
+  inspect(envelope.payload,schema);
+  if(!publicKey||!expectedRevision||expectedRevision==="UNCONFIRMED")fail("source_evidence_trust_required");
+  if(typeof publicKey==="string"&&publicKey.includes("PRIVATE KEY"))fail("source_evidence_public_key_only");
+  const key=typeof publicKey==="string"?crypto.createPublicKey(publicKey):publicKey;
+  if(key?.type!=="public"||key.asymmetricKeyType!=="ed25519")fail("source_evidence_public_key_only");
+  if(envelope.payload.revision!==expectedRevision)fail("source_evidence_revision_mismatch");
+  const age=now-Date.parse(envelope.payload.observedAt);
+  if(!Number.isFinite(age)||age< -60000||age>maxAgeMs)fail("source_evidence_expired");
+  if(typeof envelope.signature!=="string"||!/^[A-Za-z0-9+/]{86}==$/.test(envelope.signature))fail("source_evidence_signature");
+  if(!crypto.verify(null,Buffer.from(canonical(envelope.payload)),key,Buffer.from(envelope.signature,"base64")))fail("source_evidence_signature");
+  const p=envelope.payload,a=p.authority,i=p.inventory,k=p.custody,w=p.writers,r=p.recovery;
+  const source=Boolean(a.kind==="json-app-storage"&&a.runtimeBindingChecked&&a.stableReadChecked&&
+    a.datasetHmac&&a.generationHmac&&a.bucketHmac&&a.consistency!=="unverified");
+  const inventory=Boolean(source&&["accounts","employees","posts","comments","relationships"].every(n=>i[n]!==null)&&
+    i.unmappedDataFiles===0&&Object.values(i.documents).every(d=>d.present&&d.count!==null&&d.originalBytesHmac&&d.semanticHmac&&d.membershipHmac)&&
+    i.media.objectCount!==null&&i.media.byteCount!==null&&i.media.missingReferences===0&&i.media.unreadableObjects===0&&i.media.referenceClosureChecked&&i.media.manifestHmac);
+  return {format:"BQ_SOURCE_EVIDENCE_CHECK_V1",signatureVerified:true,operatorClaims:{source,inventory,
+    keyCustody:Boolean(source&&k.sessionPresent&&k.backupPresent&&k.activeAndPendingFactorsChecked&&k.originalSessionContinuityChecked&&k.keySetHmac),
+    writerInventory:Boolean(w.inventoryComplete&&w.processCount!==null&&w.httpWriters!==null&&w.backgroundWriters!==null&&w.externalWriters!==null&&w.pendingOperations!==null&&w.inventoryHmac),
+    backupRestore:Boolean(source&&r.independentBackupAvailable&&r.restoreReconciled&&r.mediaComplete&&
+      r.backupGenerationHmac===a.generationHmac&&r.restoreGenerationHmac===a.generationHmac)},
+    migrationAuthorized:false,note:"Signature authenticates the protected operator observation, not independent inspection or release approval. Observational equality is not a writer freeze."};
+}
+module.exports={schema,template,canonical,verify,documentNames};
+if(require.main===module){
+  try{
+    if(process.argv[2]==="template"&&process.argv.length===3)console.log(JSON.stringify({payload:template(),signature:null},null,2));
+    else if(process.argv[2]==="check"&&process.argv.length===6){
+      const fs=require("node:fs"),read=p=>{if(fs.statSync(p).size>128*1024)fail("source_evidence_size");return fs.readFileSync(p,"utf8");};
+      console.log(JSON.stringify(verify(JSON.parse(read(process.argv[3])),{publicKey:read(process.argv[4]),expectedRevision:process.argv[5]})));
+    }else fail("usage_template_or_check_evidence_public_key_confirmed_revision");
+  }catch(e){console.error(JSON.stringify({error:e.code?.startsWith("source_")?e.code:"source_evidence_rejected",migrationAuthorized:false}));process.exitCode=1;}
+}
