modules = ["nodejs-22", "python-base-3.13"]
run = "node start.js"
entrypoint = "server.js"
hidden = [".config", "node_modules", "package-lock.json"]

[env]
PORT = "4173"
HOST = "0.0.0.0"

[[ports]]
localPort = 4173
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5108
externalPort = 5173

[[ports]]
localPort = 5109
externalPort = 6000

[[ports]]
localPort = 5131
externalPort = 3003

[[ports]]
localPort = 5134
externalPort = 9000

[[ports]]
localPort = 5138
externalPort = 6800

[[ports]]
localPort = 5139
externalPort = 8000

[[ports]]
localPort = 5140
externalPort = 8008

[[ports]]
localPort = 5150
externalPort = 8080

[[ports]]
localPort = 5151
externalPort = 8081

[[ports]]
localPort = 5163
externalPort = 8099

[[ports]]
localPort = 5180
externalPort = 3002
exposeLocalhost = true

[[ports]]
localPort = 5181
externalPort = 3000

[[ports]]
localPort = 5183
externalPort = 3001

[[ports]]
localPort = 5185
externalPort = 4200

[deployment]
deploymentTarget = "vm"
build = ["npm", "ci", "--omit=dev"]
run = ["node", "release-preparation/production-bindings/maintenance-check.cjs"]
ignorePorts = false

[objectStorage]
defaultBucketID = "replit-objstore-44cb0252-dd69-42fb-8f2d-af513c735acb"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Private synthetic feed API"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node development/postgres/launch.cjs"
waitForPort = 5000

[[workflows.workflow]]
name = "Private synthetic feed API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/postgres/phase2f/preview-server.cjs"

[workflows.workflow.metadata]
outputType = "console"

[nix]
channel = "stable-25_05"
packages = ["postgresql_16"]

[userenv]

[userenv.production]
BQ_MINIMAL_BINDINGS_CHECK = "approved-readonly-check"
