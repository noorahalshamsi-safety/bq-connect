modules = ["nodejs-22"]
run = "node start.js"
entrypoint = "server.js"
hidden = [".config", "node_modules", "package-lock.json"]

[env]
PORT = "4173"
HOST = "0.0.0.0"

[[ports]]
localPort = 4173
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[deployment]
deploymentTarget = "vm"
build = ["npm", "install", "--omit=dev"]
run = ["node", "start.js"]

[objectStorage]
defaultBucketID = "replit-objstore-df2b12f8-b7e9-4f8b-bb9d-e3f13ecdeb0d"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Private synthetic feed API"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node development/postgres/launch.cjs"
waitForPort = 5000

[[workflows.workflow]]
name = "Private synthetic feed API"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/postgres/phase2f/preview-server.cjs"

[workflows.workflow.metadata]
outputType = "console"

[nix]
channel = "stable-25_05"
packages = ["postgresql_16"]
